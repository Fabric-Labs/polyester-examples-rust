# Polyester API key credentials. Username is optional; Account ID auth is valid.
# Create an API key in the Polyester app, then copy the key id and private key.
# Public examples (01, 04, 05, 06) run without these. Uncomment and fill in for
# authenticated examples, or copy from ../polyester-sdk-rust/.env if you already have one.
# Subaccount-scoped keys need an attached API-key policy with ledger-read
# permission for balances/private balance streams, plus trading for mutations.
# This is separate from the subaccount policy; both apply.
# POLYESTER_API_KEY_ID=ak_your_key_id_here
# POLYESTER_API_PRIVATE_KEY=your_64_char_ed25519_private_key_hex

# Account ID from Profile in the Polyester app, for example RLxqJGUDg92.
# POLYESTER_ACCOUNT_ID=your_account_id_here

# Optional: target a specific subaccount. Leave empty for the main account.
# POLYESTER_SUB_ACCOUNT_ID=

# Optional endpoint overrides. Defaults target devnet.
# POLYESTER_API_URL=https://api-devnet.polyester.ai
# POLYESTER_WS_URL=wss://api-devnet.polyester.ai

# Owner EOA private key for smart-account Funding UserOps (examples 16/17 submit).
# POLYESTER_OWNER_PRIVATE_KEY=0x_your_owner_private_key_hex

# Example defaults.
POLYESTER_EXAMPLES_SYMBOL=BTC-USDT
POLYESTER_EXAMPLES_TIMEFRAME=1m
POLYESTER_EXAMPLES_CANDLE_LIMIT=100

# Live order writes are disabled unless this is explicitly set to 1.
# Never reuse this flag for transfers, withdrawals, or chain UserOps.
POLYESTER_EXAMPLES_ENABLE_TRADING=0

# Maximum quote notional used by write examples, usually USDT.
POLYESTER_EXAMPLES_MAX_QUOTE=10

# RSI bot knobs.
POLYESTER_EXAMPLES_RSI_PERIOD=14
POLYESTER_EXAMPLES_RSI_OVERSOLD=30
POLYESTER_EXAMPLES_RSI_OVERBOUGHT=70
POLYESTER_EXAMPLES_ORDER_TIMEOUT_SEC=15
POLYESTER_EXAMPLES_POLL_SEC=0.5

# Public realtime examples.
POLYESTER_EXAMPLES_STREAM_COUNT=5
POLYESTER_EXAMPLES_ORDERBOOK_DEPTH=50

# --- Transfers (example 14). Separate from ENABLE_TRADING. ---
# POLYESTER_EXAMPLES_ENABLE_TRANSFERS=0
# POLYESTER_EXAMPLES_TRANSFER_DEST_ACCOUNT_ID=destination_account_id
# POLYESTER_EXAMPLES_TRANSFER_AMOUNT=0.01

# --- API-key Trading->Funding withdraw (example 15). Prepare always; submit only when 1. ---
# POLYESTER_EXAMPLES_ENABLE_WITHDRAWALS=0
# POLYESTER_EXAMPLES_WITHDRAW_AMOUNT=0.01

# --- On-chain Funding UserOps (examples 16/17). Separate from ENABLE_TRADING. ---
# POLYESTER_EXAMPLES_ENABLE_CHAIN_FUNDING_TO_TRADING=0
# POLYESTER_EXAMPLES_ENABLE_CHAIN_EXTERNAL_SUBMIT=0
# POLYESTER_EXAMPLES_CHAIN_AMOUNT=1
# POLYESTER_EXAMPLES_EXTERNAL_DESTINATION=0x_your_external_address
# POLYESTER_EXAMPLES_EXTERNAL_CHAIN_ID=6
